@article{kuipersTalkingTroublesGender1986,
  title = {Talking about {{Troubles}}: {{Gender Differences}} in {{Wey{\'e}wa Speech Use}}},
  shorttitle = {Talking about {{Troubles}}},
  author = {Kuipers, Joel C.},
  year = {1986},
  journal = {American Ethnologist},
  volume = {13},
  number = {3},
  eprint = {644097},
  eprinttype = {jstor},
  pages = {448--462},
  publisher = {[Wiley, American Anthropological Association]},
  urldate = {2020-07-21},
  abstract = {In the Wey{\'e}wa highlands of western Sumba, men and women employ a richly metaphorical, poetic form of "ritual speech" in response to sudden misfortune. Men's speech, in the context of divination, placation rites, and celebration songs, tends to be strictly parallelistic, narrative, and indirect, and concerns the continuity of the patriline. Men are regularly paid for their performances, but may be fined for errors. Women's ritual responses to misfortune consist of evocative laments and ululations. While women's speech may influence the immediate social environment, females are not fined for errors. This division of labor in speech relates systematically to the cultural notions of descent as well as the cultural construction of gender in Wey{\'e}wa society. [division of labor; misfortune; ethnography of speaking; gender; Indonesia]}
}

