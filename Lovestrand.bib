@article{sohnMetathesisKwaraAe1980,
  title = {Metathesis in {{Kwara}}'ae},
  author = {Sohn, Ho-min},
  year = {1980},
  journal = {Lingua},
  volume = {52},
  number = {3},
  pages = {305--323},
  abstract = {Unlike most languages, Kwara'ae has a powerful synchronic phonological rule of metathesis, which feeds most other phonological rules in the language. This paper establishes some justification for the rule, presenting forms and alternations that motivate metathesis and providing some evidence that the rule is psychologically real. The paper further examines the interaction of the rule with other major phonological rules, and reviews Ultan's hypotheses on the nature of metathesis, concluding that Kwara'ae evidence does not support them. Kwara'ae metathesis is characterized as a process of minimizing the number of syllables by converting open to closed syllables, with a minimum loss of phonological features as well as of communication.}
}

