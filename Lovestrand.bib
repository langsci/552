@article{forthBloodMilkCoconuts1983,
  title = {Blood, {{Milk}} and {{Coconuts}}: {{A Study}} of {{Intra-Cultural Ritual Variation}}},
  shorttitle = {Blood, {{Milk}} and {{Coconuts}}},
  author = {Forth, Gregory},
  year = {1983},
  journal = {Man},
  volume = {18},
  number = {4},
  eprint = {2801901},
  eprinttype = {jstor},
  pages = {654--668},
  doi = {10.2307/2801901},
  urldate = {2020-07-21},
  abstract = {In one area of the ritual life of an eastern Indonesian community, marked variation in practice between component groups co-exists with a common set of associated ideas. The rites in question, of which there are two, are employed when conferring a name upon a newborn child, and the ideas refer to the nature of proper names and, particularly, the relationship between a person and the ancestor after whom he is named. This article demonstrates how the two rituals are related to one another and how each is connected with wider themes bearing on the relationship between ancestors and descendants; it furthermore shows how both usages can be accommodated to unvarying ideas regarding names and naming.}
}

