@misc{lovestrandNyokonWordList2020,
  title = {{Nyokon word list audio recordings}},
  author = {Lovestrand, Joseph},
  year = {2020},
  publisher = {Zenodo},
  doi = {10.5281/zenodo.3962412},
  urldate = {2021-11-29},
  abstract = {This deposit contains the original recorded lists of words of the Nyokon language (ISO 639-3: nvo) gathered in the process of writing the following publication:~ Lovestrand, Joseph. 2011. Notes on Nyokon phonology (Bantu A.45, Cameroon). SIL Cameroon. http://silcam.org/download.php?stid=\&folder=documents\&file=Nyokon\_notes\_phonology-Lovestrand\_2011.pdf. A PDF copy of the publication is included in the deposit [Notes on Nyokon phonology - Lovestrand (October 2011).pdf] Rough phonetic transcriptions and annotations of the word lists are in SML format in the file: [Nyokon-dekereke.txt] This file was designed in the freeware Dekereke program, available online at: https://casali.canil.ca/ The audio recordings can be divided into four categories.~ 1. 1700-item word list Files named with a range of four-digit numbers, e.g. 0001-0005.wav, are the original audio files. The numbers refer to the "SIL comparatige African wordlist". Not all 1700 items were elicted and recorded.~ Roberts, James \& Keith Snider. 2006. SIL comparative African wordlist (SILCAWL). SIL~ Electronic Working Papers 2006-005. 49. http://www.sil.org/silewp/abstract.asp?ref=2006-005 2. Individual words for Dekereke~ Files name with a single four-digit number followed by an English gloss, e.g. 0001 body, are audio clips taken from the origial recordings so that the clips can be listened to in the Dekereke program.~ Not all words were clipped for this purpose. The recordings of many words are only availabel in the original recordigns. 3. Contrastive Pairs~ Files named ContrastivePairs followed by a number are files that were recorded later in the analysis to check on assumed and suspected phonemic contrast. Most of the words repeat those found elsewhere.~ 4. Consent~ There are a number of files recording the oral consent of the Nyokon speakers who participated in the word list elicitation sessions.~ As acknolwedged in Lovestrand (2011) the Nyokon speaker who participated are: NGOUNG Isaac (chief of Ambann) NGAGNI Amos Jules (chief of Ahoung) AMBANG Maurice EMBOM Pierre ENAM Samuel FOUTH Brice Rodrigue HEU Emmanuel HEU Paul IMBO Hermine Doroth{\'e}e KAMANDA Jean Achille KIARI Andr{\'e} Jules KOUMA Fanny MBIRNANG Thomas Blaise MOUOL Catherine NGAGNI Emmanuel YAMBASA Andr{\'e}},
  langid = {nvo}
}

