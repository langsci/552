@article{leonardReflectionsColonialismLanguage2018,
  title = {Reflections on (de)Colonialism in Language Documentation},
  author = {Leonard, Wesley Y.},
  editor = {McDonnell, Bradley and {Berez-Kroeker}, Andrea L. and Holton, Gary},
  year = {2018},
