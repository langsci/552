@phdthesis{mokChineseSoundSymbolism2001,
  title = {Chinese Sound Symbolism: {{A}} Phonological Perspective},
  shorttitle = {Chinese Sound Symbolism},
  author = {Mok, Waiching Enid},
  year = {2001},
  address = {United States -- Hawaii},
  urldate = {2022-06-16},
  abstract = {Sound-symbolic words are generally ignored in linguistic description and discussion despite the fact that they are abundant and conspicuous in many languages. When they get mentioned, they are often treated as marginal to or even outside of language proper. So far, there have been very few serious synchronic or diachronic studies devoted to this part of the lexicon. This dissertation is an attempt to provide a thorough description and a systematic analysis of the phonological aspects of the sound-symbolic words and expressions in three major Chinese languages: Mandarin, Cantonese and Hakka. In consideration of the spoken nature of sound-symbolic vocabulary, the primary source of data for this study came from present-day speech. Published materials were used as secondary data after verification by native speakers. Collected data were examined intra- and interlinguistically from both synchronic and diachronic perspectives. The goals of this study are: (1) To enhance our knowledge of Chinese phonologies by taking sound-symbolic vocabulary into account; (2) To explore whether an empirical basis exists for a theoretical distinction between the phonology of ordinary language and that of sound-symbolic language; and (3) To test the general hypothesis about onomatopoetic resistance to sound change. Discussion of the findings draws upon the insights of current theories such as Lexical Phonology, Autosegmental Phonology, Natural Phonology, and the Lexical Diffusion Model for sound change. Chapter One provides the background to the present study, defines onomatopoeia and ideophone, and introduces the theoretical frameworks in which the data are discussed. Chapter Two summarizes previous findings in Chinese and other languages. Chapter Three outlines the phonological systems of Mandarin, Cantonese and Hakka. Chapter Four presents the objective of this study, research questions, sources of data, and fieldwork. Chapter Five provides quantitative and qualitative analyses of the collected data. Chapter Six focuses on reduplication. Chapter Seven deals with tone change and tone sandhi. Chapter Eight discusses various descriptive and theoretical issues of Chinese sound-symbolic vocabulary. Chapter Nine explores the implications of the findings for linguistic theory and concludes the study with a brief synopsis of the findings and remarks.},
  copyright = {Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.},
  langid = {english},
  school = {University of Hawai'i at Manoa}
}

