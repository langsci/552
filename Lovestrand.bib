@article{lobelPonosakanDyingLanguage2015,
  title = {Ponosakan: {{A Dying Language}} of {{Northeastern Sulawesi}}},
  shorttitle = {Ponosakan},
  author = {Lobel, Jason William},
  year = {2015},
  journal = {Oceanic Linguistics},
  volume = {54},
  number = {2},
