@inproceedings{pullumDistinctionModelTheoreticGenerativeEnumerative2001,
  title = {On the {{Distinction}} between {{Model-Theoretic}} and {{Generative-Enumerative Syntactic Frameworks}}},
  booktitle = {Logical {{Aspects}} of {{Computational Linguistics}}},
  author = {Pullum, Geoffrey K. and Scholz, Barbara C.},
  editor = {{de Groote}, Philippe and Morrill, Glyn and Retor{\'e}, Christian},
  year = {2001},
  series = {Lecture {{Notes}} in {{Computer Science}}},
  pages = {17--43},
  publisher = {Springer},
  address = {Berlin, Heidelberg},
  doi = {10.1007/3-540-48199-0_2},
  abstract = {Two kinds of framework for stating grammars of natural languages emerged during the 20th century. Here we call them generative-enumerative syntax (GES)an d model-theoretic syntax (MTS). They are based on very different mathematics. GES developed in the 1950s out of Post's work on the syntactic side of logic. MTS arose somewhat later out of the semantic side of logic. We identify some distinguishing theoretical features of these frameworks, relating to cardinality of the set of expressions, size of individual expressions, and `transderivational constraints'. We then turn to three kinds of linguistic phenomena: partial grammaticality, the syntactic properties of expression fragments, and the fact that the lexicon of any natural language is in constant flux, and conclude that MTS has some major advantages for linguistic description that have been overlooked. We briefly consider the issue of what natural languages in MTS terms, and touch on implications for parsing and acquisition.},
  langid = {english}
}

