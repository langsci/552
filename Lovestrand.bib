@article{hoskinsHeadhunterHeroLocal1987,
  title = {The {{Headhunter}} as {{Hero}}: {{Local Traditions}} and {{Their Reinterpretation}} in {{National History}}},
  shorttitle = {The {{Headhunter}} as {{Hero}}},
  author = {Hoskins, Janet},
  year = {1987},
  journal = {American Ethnologist},
  volume = {14},
