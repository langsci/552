@incollection{sahooArgumentSharingOriya2006,
  title = {Argument {{Sharing}} in {{Oriya Serial Verb Constructions}}},
  booktitle = {Case, {{Valency}} and {{Transitivity}}},
  author = {Sahoo, Kalyanamalini},
  editor = {Kulikov, Leonid and Malchukov, Andrej and {de Swart}, Peter},
  year = {2006},
  series = {Studies in {{Language Companion Series}}},
  number = {77},
  pages = {203--221},
  publisher = {John Benjamins},
  doi = {10.1075/slcs.77.13sah},
  abstract = {Investigating the notion of `argument sharing' in Oriya serial verb constructions (SVCs), this article presents an analysis which allows multiple verbal predicates sharing internal as well as external arguments, enter into a mono-clausal structure without necessarily forming a complex predicate nucleus. The `shared object', which poses a challenge for the cross-linguistic generalization on the syntactic position of the `shared object', raises the choice between 'tokensharing' vs. 'reference-sharing'. Having laid out possible theoretical construals of the notion `arguments-sharing', the paper concludes that Oriya VP-serialization exhibits the referent-based function-sharing between arguments profile.}
}

