@article{souagEkkehardWolffHistorical2023,
  title = {Review: {H}. {{Ekkehard Wolff}}, {{A}} Historical Phonology of {{Central Chadic}}: {{Prosodies}} and Lexical Reconstruction},
  shorttitle = {H. {{Ekkehard Wolff}}, {{A}} Historical Phonology of {{Central Chadic}}},
