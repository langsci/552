@article{silva-roblesElicitingAssociatedMotion2022,
  title = {Eliciting {{Associated Motion Constructions}} in {{Two Zapotec Languages}}},
  author = {{Silva-Robles}, Fe and Lopez, Felipe and Duff, John and Anderson, Carolyn},
  year = {2022},
  journal = {Semantic Fieldwork Methods},
  volume = {4},
  number = {3},
  pages = {1--51},
  urldate = {2024-02-07},
  abstract = {In associated motion constructions, verbal morphology adds a motion event to a main verb. The resulting construction can have complex interactions with verbal meaning that merit careful investigation in a fieldwork setting. In this paper, we describe our experiences as semanticists and language consultants exploring associated motion in two Zapotec languages: Dille' xhunh Laxup (Santiago Laxopa Zapotec) and Dizhsa (San Lucas Quiavin{\'i} Zapotec). We present an original storyboard and other materials used in our work, and reflect on our experiences at three different levels: (i) what we have learned about the semantics of associated motion constructions in these particular languages; (ii) what we have learned about eliciting associated motion constructions; and (iii) what we have learned about working together as fieldworkers and language experts.},
  copyright = {Copyright (c) 2022 Fe Silva-\-Robles, Felipe H. Lopez, John Duff, Carolyn Anderson},
  langid = {english}
}

