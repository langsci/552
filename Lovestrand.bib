@incollection{schnellReflectionsRoleLanguage2018,
  title = {Reflections on the Role of Language Documentations in Linguistic Research},
  booktitle = {Reflections on {{Language Documentation}} 20 {{Years}} after {{Himmelmann}} 1998},
  author = {Schnell, Stefan},
  editor = {McDonnell, Bradley and {Berez-Kroeker}, Andrea L. and Holton, Gary},
