@book{hoskinsBiographicalObjectsHow1998,
  title = {Biographical {{Objects}}: {{How Things Tell}} the {{Stories}} of {{People}}'s {{Lives}}},
  shorttitle = {Biographical {{Objects}}},
  author = {Hoskins, Janet},
  year = {1998},
  publisher = {Psychology Press},
  abstract = {In this innovative study, six women and men from Eastern Indonesia narrate their own lives by talking about their possessions--domestic objects used to construct a coherent identity through a process of identification and "self-historicizing." Janet Hoskins explores how things are given biographical significance and entangled in sexual politics, expressed in dualistic metaphors where the familiar distinctions between person and object and female and male are drawn in unfamiliar ways. "Biographical Objects" is an ethnography of persons which takes the form of a study of things, showing how the object is not only a metaphor for the self but a pivot for reflexivity and introspection, a tool for autobiographic elaboration, a way of knowing oneself through things --},
