@incollection{vydrinClauseChainingBambara2020,
  title = {Clause Chaining in {{Bambara}}},
  booktitle = {West {{African}} Languages. {{Linguistic}} Theory and Communication},
  author = {Vydrin, Valentin},
  editor = {Pawlak, Nina and Will, Izabela},
  year = {2020},
  publisher = {University of Warsaw Press},
  doi = {10.31338/uw.9788323546313.pp.79-98},
  urldate = {2025-08-22},
  abstract = {Bambara (Manding {$<$} West Mande {$<$} Mande {$<$} Niger-Congo) has a specialized clause chaining (cosubordinative) construction where the first clause has a verb full-fledged for TAM and polarity, and verbs of subsequent clauses are in infinitive; non-initial clauses are not embedded into the initial one and cannot be therefore regarded as subordinate. Characteristics of the Bambara clause chaining are analyzed: scope of operators (illocutionary force, negation), TAM characteristics, same- and different-subjectness. From the evidence of peripheral Manding varieties, a hypothesis concerning the origin of infinitive from an archaic preposition is advanced.},
  langid = {english}
}

