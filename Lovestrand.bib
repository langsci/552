@article{douvenConditionalsInferentialConnections2020,
  title = {Conditionals and Inferential Connections: Toward a New Semantics*},
  shorttitle = {Conditionals and Inferential Connections},
  author = {Douven, Igor and Elqayam, Shira and Singmann, Henrik and van {Wijnbergen-Huitink}, Janneke},
  year = {2020},
  journal = {Thinking \& Reasoning},
  volume = {26},
  number = {3},
  pages = {311--351},
  publisher = {Routledge},
  doi = {10.1080/13546783.2019.1619623},
  urldate = {2024-09-30},
  abstract = {In previous published research (``Conditionals and Inferential Connections: A Hypothetical Inferential Theory,'' Cognitive Psychology, 2018), we investigated experimentally what role the presence and strength of an inferential connection between a conditional's antecedent and consequent plays in how people process that conditional. Our analysis showed the strength of that connection to be strongly predictive of whether participants evaluated the conditional as true, false, or neither true nor false. In this article, we re-analyse the data from our previous research, now focussing on the semantics of conditionals rather than on how they are processed. Specifically, we use those data to compare the main extant semantics with each other and with inferentialism, a semantics according to which the truth of a conditional requires the presence of an inferential connection between the conditional's component parts.}
}

