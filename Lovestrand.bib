@article{yipCantoneseLoanwordPhonology1993,
  title = {Cantonese Loanword Phonology and {{Optimality Theory}}},
  author = {Yip, Moira},
  year = {1993},
  journal = {Journal of East Asian Linguistics},
  volume = {2},
  number = {3},
  pages = {261--291},
  abstract = {I will argue that loanword phonology in Cantonese does not exist as a separate component of the grammar and that the differences between English language source forms and their Cantonese equivalents can be understood as the result of subjecting non-native inputs to the constraints that define well-formed Cantonese words. I adopt Silverman's proposal that Cantonese speakers do not perceive all the same distinctions as English speakers; this perceived input is then checked by a group of ranked constraints that are independently motivated for native Cantonese, and minimal adjustments are made to produce an output that is optimal with respect to those constraints. Prominent among the constraints are (i) a set of syllable-structure conditions, (ii) a strong preference for matching the input as closely as possible, and (iii) a tendency towards bi-syllabic Minimal Words. The analysis is worked out within Optimality theory and to the extent that it is successful provides support for that emerging theory. The analysis also has certain specific theoretical implications; in particular, it is argued that the preference for matching the input (FAITHFULNESS) may not be identified with the pair of more specific constraints, PARSE and FILL.},
  langid = {english}
}

