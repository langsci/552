@article{boersmaEmpiricalTestsGradual2001,
  title = {Empirical {{Tests}} of the {{Gradual Learning Algorithm}}},
  author = {Boersma, Paul and Hayes, Bruce},
  year = {2001},
  journal = {Linguistic Inquiry},
  volume = {32},
  number = {1},
  pages = {45--86},
  doi = {10.2307_4179137},
  abstract = {The gradual learning algorithm (Boersma, 1997) is a constraint-ranking algorithm for learning optimality-theoretic grammars. The purpose of this article is to assess the capabilities of the gradual learning algorithm, particularly in comparison with the constraint demotion algorithm of Bruce Tesar \& Paul Smolensky (eg, 2000), which initiated the learnability research program for optimality theory. We argue that the gradual learning algorithm has a number of special advantages: it can learn free variation, deal effectively with noisy learning data, \& account for gradient well-formedness judgments. The case studies we examine involve Ilokano reduplication \& metathesis, Finnish genitive plurals, \& the distribution of English light \& dark /l/. 3 Appendixes, 60 References. Adapted from the source document}
}

